# Copiar para .env.local (desenvolvimento). Só as variáveis VITE_ chegam ao browser.

# Backend (sem /api no fim). Vazio em produção: a API está no mesmo domínio, em /api.
# Se não estiver definido, em desenvolvimento usa http://localhost:8080.
VITE_API_URL=http://localhost:8080

# URL público do site (SEO: canonical e Open Graph)
VITE_SITE_URL=https://chuanga-studio.com
